{
  "name": "tencent-meeting-sdk-linux-demo",
  "version": "0.1.0",
  "description": "腾讯会议 Linux ARM64 Electron Demo（阶段 2 SDK 接入准备）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "install": "node -e \"console.log('Native addon builds are Linux ARM64 only; run npm run build:native:linux-arm64 on the target host.')\"",
    "start": "electron .",
    "start:mock": "cross-env MEETING_DEMO_MOCK=1 electron .",
    "sdk:import": "node scripts/import-sdk.js",
    "sdk:verify": "node scripts/verify-sdk.js",
    "sdk:reset-incomplete": "node scripts/reset-incomplete-import.js",
    "sdk:stage": "node scripts/stage-sdk.js",
    "build:native:linux-arm64": "node scripts/build-native.js",
    "poc:linux-arm64": "electron scripts/poc-linux-arm64.js",
    "verify:runtime": "node scripts/verify-runtime.js",
    "github:preflight": "node scripts/github-preflight.js",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint . --max-warnings=0",
    "pack:linux:arm64": "electron-builder --linux AppImage --arm64 --dir",
    "dist:linux:arm64": "electron-builder --linux AppImage --arm64"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.18.0",
    "node-gyp": "^11.1.0"
  },
  "build": {
    "appId": "com.tencent.meeting.sdk.linux.demo",
    "productName": "TencentMeetingSdkLinuxDemo",
    "asar": true,
    "files": [
      "main.js",
      "src/**/*",
      "!src/main/sdk/mock-sdk.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "output/linux-arm64",
        "to": "tmsdk/linux-arm64"
      }
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Development",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
