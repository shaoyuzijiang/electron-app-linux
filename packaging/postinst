#!/bin/sh
set -e
SANDBOX=/opt/tencent-meeting-sdk-linux-demo/runtime/chrome-sandbox
if [ -f "$SANDBOX" ]; then
  chown root:root "$SANDBOX"
  chmod 4755 "$SANDBOX"
fi
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database /usr/share/applications || true
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
command -v xdg-mime >/dev/null 2>&1 && xdg-mime default tencent-meeting-sdk-linux-demo.desktop x-scheme-handler/wemeetsdk || true
exit 0
